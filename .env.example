# Anthropic Claude API Key - Get from https://console.anthropic.com
# This is required for the AI chatbot to work
ANTHROPIC_API_KEY=your_api_key_here

# SendGrid for email (optional)
SENDGRID_API_KEY=your_sendgrid_key_here

# Supabase (blog view counts, hearts, comments)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/anon key - safe in browser, RLS-gated
SUPABASE_ANON_KEY=sb_publishable_...
# Secret/service-role key - SERVER ONLY, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Copy this file to .env and fill in your actual keys
